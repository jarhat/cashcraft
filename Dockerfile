FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG BCH_NETWORK=mainnet
ENV BCH_NETWORK=$BCH_NETWORK
ARG VITE_CONSOLE_LOG_LEVEL=error
ENV VITE_CONSOLE_LOG_LEVEL=$VITE_CONSOLE_LOG_LEVEL
ARG VITE_NETCRAFT_WS_URL
ENV VITE_NETCRAFT_WS_URL=$VITE_NETCRAFT_WS_URL
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 8080
