:8080 {
  encode gzip
  handle /api/* {
    reverse_proxy auth:3000
  }
  @unfurler {
    header_regexp ua User-Agent (?i)(telegrambot|twitterbot|facebookexternalhit|whatsapp|discordbot|slackbot|linkedinbot|skypeuripreview)
    expression `{path}.startsWith("/s/") || {query}.contains("addr=")`
  }
  handle @unfurler {
    rewrite * /api/preview
    reverse_proxy auth:3000 {
      header_up X-Original-URI {http.request.orig_uri}
      header_up X-Preview-Origin {scheme}://{host}
    }
  }
  handle {
    root * /srv
    templates
    try_files {path} /index.html
    file_server
  }
}
