:8080 {
  encode gzip
  handle /craftws {
    reverse_proxy netcraft-websockify:4081
  }
  handle /api/* {
    reverse_proxy auth:3000 {
      header_up X-Preview-Origin {scheme}://{host}
    }
  }
  handle /games/* {
    root * /srv
    header Access-Control-Allow-Origin *
    file_server
  }
  @craft_unfurler {
    path /craft /craft/
    header_regexp craftua User-Agent (?i)(telegrambot|twitterbot|facebookexternalhit|whatsapp|discordbot|slackbot|linkedinbot|skypeuripreview)
  }
  handle @craft_unfurler {
    root * /srv
    rewrite * /craft-preview.html
    templates
    file_server
  }
  @unfurler {
    header_regexp ua User-Agent (?i)(telegrambot|twitterbot|facebookexternalhit|whatsapp|discordbot|slackbot|linkedinbot|skypeuripreview)
    expression `{path}.startsWith("/s/") || {query}.contains("addr=")`
  }
  handle @unfurler {
    rewrite * /api/preview
    reverse_proxy auth:3000 {
      header_up X-Original-URI {http.request.orig_uri}
      header_up X-Preview-Origin {scheme}://{host}
    }
  }
  handle {
    root * /srv
    templates
    try_files {path} /index.html
    file_server
  }
}
