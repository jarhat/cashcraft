VITE_BCH_NETWORK=mainnet
# Wallet /api requests are proxied to this deployment's auth service.
# Local Vite development expects auth on 127.0.0.1:3001.
# App console logging: debug, error (production default), or off.
# Rebuild the frontend after changing this. Wallet SDK logs are independent.
# VITE_CONSOLE_LOG_LEVEL=off
BCH_NETWORK=mainnet
BCH_RPC_USER=replace_with_a_long_random_username
BCH_RPC_PASSWORD=replace_with_a_long_random_password
# BCHN creates/loads this wallet on startup. Fund it with BCH and the reward
# token and keep it unlocked for signing. Never expose RPC credentials publicly.
BCH_WALLET=token-sender
# GAMBA CashToken category ID; each newly saved address receives one base unit.
# The public address endpoint can be abused to exhaust wallet funds. Back up
# the address database with the wallet; pending reward errors are logged.
# Do not replace or delete the database while auth is running. Restore its
# original file if the reward ledger disappears; pending grants cannot be
# reconstructed safely from the address list.
BCH_REWARD_CATEGORY=64_hex_character_category_id
# Optional; only needed when using /api/tx-proof.
# BCH_ALLOWED_SENDER=bitcoincash:your_proof_funding_address
# BCH_ALLOWED_TOKEN_CATEGORIES=64_hex_character_category_id
BCH_REQUIRED_CONFIRMATIONS=0
BCH_PRUNE_MIB=10000
# Complete Emscripten builds, mounted read-only into the frontend. Include
# craftw.html and its JS/WASM/data files, and index.html with the PK2 files.
# Missing directories are created empty; the corresponding game is unavailable
# until the build files are installed and the frontend is restarted.
# NETCRAFT_BUILD_PATH=./NetCraft/build
# PK2_BUILD_PATH=./PK2/build
