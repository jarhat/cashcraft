VITE_BCH_NETWORK=mainnet
# Public frontend URLs, embedded at build time. Leave Telegram/feed blank to hide
# the link/show a fallback. Gallery feed must allow CORS and return a JSON array
# of {"title":"...","image":"https://...","url":"https://..."} objects.
VITE_GITHUB_URL=https://github.com/jarhat/cashcraft
VITE_TELEGRAM_URL=
VITE_GALLERY_FEED_URL=
BCH_NETWORK=mainnet
BCH_RPC_USER=replace_with_a_long_random_username
BCH_RPC_PASSWORD=replace_with_a_long_random_password
BCH_ALLOWED_SENDER=bitcoincash:...
BCH_ALLOWED_TOKEN_CATEGORIES=64_hex_character_category_id
BCH_REQUIRED_CONFIRMATIONS=1
BCH_PRUNE_MIB=10000
