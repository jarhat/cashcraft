# Optional; only needed when using /api/tx-proof.
# BCH_ALLOWED_SENDER=bitcoincash:your_proof_funding_address
# BCH_ALLOWED_TOKEN_CATEGORIES=64_hex_character_category_id
BCH_REQUIRED_CONFIRMATIONS=0
BCH_PRUNE_MIB=10000
# Public DNS name pointing to this host's HTTPS proxy. ACME obtains a
# certificate for it; the browser connects to wss://<name>/craftws.
# NETCRAFT_WS_DOMAIN=play.example.com
# Complete Emscripten builds, mounted read-only into the frontend. Include
# craftw.html and its JS/WASM/data files, and index.html with the PK2 files.
# Missing directories are created empty; the corresponding game is unavailable
# until the build files are installed and the frontend is restarted.
# NETCRAFT_BUILD_PATH=./NetCraft/build
# PK2_BUILD_PATH=./PK2/build
