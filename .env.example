VITE_BCH_NETWORK=mainnet
# Wallet /api requests are proxied to this deployment's auth service.
# Local Vite development expects auth on 127.0.0.1:3001.
# App console logging: debug, error (production default), or off.
# Rebuild the frontend after changing this. Wallet SDK logs are independent.
# VITE_CONSOLE_LOG_LEVEL=off
BCH_NETWORK=mainnet
# Optional prefixed P2PKH CashAddr (bitcoincash:q…). Leave blank to disable
# admin powers. This is a public address, never a seed or private key.
BCH_RPC_USER=replace_with_a_long_random_username
BCH_RPC_PASSWORD=replace_with_a_long_random_password
# BCHN creates/loads this wallet on startup. Fund it with BCH and the reward
# token and keep it unlocked for signing. Never expose RPC credentials publicly.
BCH_WALLET=token-sender
# MINA CashToken category ID; each newly saved address receives one base unit.
# The public address endpoint can be abused to exhaust wallet funds. Back up
# the address database with the wallet; pending reward errors are logged.
# Do not replace or delete the database while auth is running.
# If the file disappears, auth recreates an empty ledger automatically.
# Restore backups if historical pending grants and payout totals matter.
BCH_REWARD_CATEGORY=64_hex_character_category_id
# Every ten natural, previously unedited MINA ore blocks earn one base unit of
# BCH_REWARD_CATEGORY. Mining is not authenticated and payouts have no daily
# limits, so automated mining can exhaust the payout wallet.
# Keep both databases and the BCHN wallet backed up together.
# Stop auth and NetCraft before migrating or restoring a backup. See
# backend/README.md for existing SQLite deployments. Compose fixes ownership
# for their shared unprivileged UID; /data must support SQLite rollback journals.
# Optional distinct CashToken categories (64 hex characters each).
# Blue lapis and red redstone each earn one base unit per ten natural blocks.
# Gold retains its legacy one-per-block reward. An empty category disables
# payouts for that ore, not ore generation or leaderboard tracking.
BCH_REDSTONE_REWARD_CATEGORY=
BCH_GOLD_REWARD_CATEGORY=
BCH_LAPIS_REWARD_CATEGORY=
# Legacy crafting configuration. Pickaxe crafting instead generates a unique
# token-aware receive address in BCH_WALLET for each registered player.
CRAFTING_ADDRESS=
CRAFTING_RETURN_CATEGORY=
NETCRAFT_MINING_REWARDS_ENABLED=true
# A long random, ASCII secret shared by NetCraft and the backend API.
# The server refreshes BCHN's mempool about every 10 seconds through the
# backend, even with mining rewards disabled. Each pending transaction
# gets an animal near active players as terrain allows. Rebuild the NetCraft
# client to show the abbreviated transaction IDs above the animals.
NETCRAFT_REWARD_WAKE_SECRET=replace_with_a_long_random_secret
BCH_PRUNE_MIB=10000
# Public DNS name pointing to this host's HTTPS proxy. ACME obtains a
# certificate for it; the browser connects to wss://<name>/craftws.
# NETCRAFT_WS_DOMAIN=play.example.com
# Complete Emscripten builds, mounted read-only into the frontend. Include
# craftw.html and its JS/WASM/data files, and index.html with the PK2 files.
# Missing directories are created empty; the corresponding game is unavailable
# until the build files are installed and the frontend is restarted.
# NETCRAFT_BUILD_PATH=./NetCraft/build
# PK2_BUILD_PATH=./PK2/build
